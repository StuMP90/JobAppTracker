<Window x:Class="JobAppTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:JobAppTracker.Converters"
        mc:Ignorable="d"
        Title="Job Application Tracker" Height="820" Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullToVisConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <!-- KPI Card Style -->
        <Style x:Key="KpiCardStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top App Bar -->
            <RowDefinition Height="Auto"/> <!-- KPI Banner -->
            <RowDefinition Height="Auto"/> <!-- Filter Ribbon -->
            <RowDefinition Height="*"/>    <!-- Master-Detail Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top App Bar -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💼" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Job Application Tracker" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Manage job search, speculative agency CVs, specs &amp; follow-ups" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="📄 Quick CV to Agency" Margin="0,0,10,0" Padding="14,7" Background="#0369A1" Foreground="White" 
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnQuickCv_Click"/>
                    <Button Content="+ New Application" Margin="0,0,14,0" Padding="16,7" Background="#2563EB" Foreground="White" 
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnNewApp_Click"/>
                    <Button Content="📊 Reports" Margin="0,0,8,0" Padding="12,7" Background="#334155" Foreground="White" 
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnReports_Click"/>
                    <Button Content="⚙️ Settings" Padding="12,7" Background="#334155" Foreground="White" 
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnSettings_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. KPI Banner -->
        <Grid Grid.Row="1" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total -->
            <Button Grid.Column="0" Style="{StaticResource KpiCardStyle}" Command="{Binding SetQuickFilterCommand}" CommandParameter="All">
                <StackPanel>
                    <TextBlock Text="{Binding Summary.TotalApplications}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="TOTAL APPLICATIONS" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>

            <!-- Active -->
            <Button Grid.Column="2" Style="{StaticResource KpiCardStyle}" Command="{Binding SetQuickFilterCommand}" CommandParameter="Active">
                <StackPanel>
                    <TextBlock Text="{Binding Summary.ActiveApplications}" FontSize="24" FontWeight="Bold" Foreground="#2563EB"/>
                    <TextBlock Text="ACTIVE / IN PROGRESS" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>

            <!-- Stale Alert -->
            <Button Grid.Column="4" Style="{StaticResource KpiCardStyle}" Background="#FFF7ED" BorderBrush="#FDBA74" 
                    Command="{Binding SetQuickFilterCommand}" CommandParameter="Stale">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding Summary.StaleApplications}" FontSize="24" FontWeight="Bold" Foreground="#EA580C"/>
                        <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="STALE (14D+ INACTIVE)" FontSize="10" FontWeight="Bold" Foreground="#EA580C" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>

            <!-- Interviews -->
            <Button Grid.Column="6" Style="{StaticResource KpiCardStyle}" Command="{Binding SetQuickFilterCommand}" CommandParameter="Interviews">
                <StackPanel>
                    <TextBlock Text="{Binding Summary.InterviewCount}" FontSize="24" FontWeight="Bold" Foreground="#D97706"/>
                    <TextBlock Text="INTERVIEWS &amp; TESTS" FontSize="10" FontWeight="SemiBold" Foreground="#D97706" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>

            <!-- Finalized -->
            <Button Grid.Column="8" Style="{StaticResource KpiCardStyle}" Command="{Binding SetQuickFilterCommand}" CommandParameter="Final">
                <StackPanel>
                    <TextBlock Text="{Binding Summary.AcceptedCount, StringFormat='{}{0} Offers'}" FontSize="24" FontWeight="Bold" Foreground="#16A34A"/>
                    <TextBlock Text="OUTCOMES &amp; ARCHIVE" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 3. Filter Ribbon -->
        <Border Grid.Row="2" Background="White" Margin="20,0,20,10" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10">
            <DockPanel LastChildFill="True">
                <!-- Quick Filter Tabs on the Right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="All" IsChecked="True" GroupName="QuickTabs" Margin="2,0" Padding="10,4" 
                                         Command="{Binding SetQuickFilterCommand}" CommandParameter="All"/>
                            <RadioButton Content="Active" GroupName="QuickTabs" Margin="2,0" Padding="10,4" 
                                         Command="{Binding SetQuickFilterCommand}" CommandParameter="Active"/>
                            <RadioButton Content="⚠️ Stale" GroupName="QuickTabs" Margin="2,0" Padding="10,4" 
                                         Command="{Binding SetQuickFilterCommand}" CommandParameter="Stale"/>
                            <RadioButton Content="Interviews" GroupName="QuickTabs" Margin="2,0" Padding="10,4" 
                                         Command="{Binding SetQuickFilterCommand}" CommandParameter="Interviews"/>
                            <RadioButton Content="Closed" GroupName="QuickTabs" Margin="2,0" Padding="10,4" 
                                         Command="{Binding SetQuickFilterCommand}" CommandParameter="Final"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Reset" Margin="8,0,0,0" Padding="10,4" Background="#F8FAFC" BorderBrush="#CBD5E1" 
                            Command="{Binding ClearFiltersCommand}"/>
                </StackPanel>

                <!-- Search and Filters on Left -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Box -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="260" Height="32" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" Foreground="#94A3B8"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12"
                                     ToolTip="Search Title, Company, Agency, Specs or Source"/>
                        </Grid>
                    </Border>

                    <!-- Status Filter -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="Status:" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Width="185" Height="32" FontSize="12"/>
                    </StackPanel>

                    <!-- Source Filter -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="Source:" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}" Width="120" Height="32" FontSize="12"/>
                    </StackPanel>

                    <!-- Method Filter -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="Method:" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding MethodOptions}" SelectedItem="{Binding SelectedMethod}" Width="110" Height="32" FontSize="12"/>
                    </StackPanel>

                    <!-- Agency Filter -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="Agency:" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding AgencyOptions}" SelectedItem="{Binding SelectedAgency}" Width="125" Height="32" FontSize="12"/>
                    </StackPanel>

                    <!-- Sort Sequence -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sort:" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortSequence}" Width="195" Height="32" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 4. Master-Detail Content Split -->
        <Grid Grid.Row="3" Margin="20,0,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="480"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Applications DataGrid -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                <DataGrid x:Name="GridApps" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          HeadersVisibility="Column" BorderThickness="0" Background="Transparent"
                          SelectionMode="Single" RowHeight="52" MouseDoubleClick="GridApps_MouseDoubleClick">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="📄 View Application Report (Print/PDF)" Click="MenuPrintReport_Click"/>
                            <Separator/>
                            <MenuItem Header="✏️ Edit Application" Click="MenuEdit_Click"/>
                            <MenuItem Header="📝 Add Update / Status" Click="MenuAddUpdate_Click"/>
                            <MenuItem Header="📎 Attach File..." Click="MenuAttach_Click"/>
                            <Separator/>
                            <MenuItem Header="📋 Copy Job Spec" Click="MenuCopySpec_Click"/>
                            <MenuItem Header="🔗 Open Job Post URL" Click="MenuOpenUrl_Click"/>
                            <Separator/>
                            <MenuItem Header="🗑️ Delete" Click="MenuDelete_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- Applied Date -->
                        <DataGridTextColumn Header="Applied" Binding="{Binding AppliedDateFormatted}" SortMemberPath="AppliedDate" Width="92"/>

                        <!-- Job Title / Role -->
                        <DataGridTemplateColumn Header="Role / Job Title" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                        <DockPanel>
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding DisplayCompanyAgency}" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Salary / Rate -->
                        <DataGridTextColumn Header="Salary / Rate" Binding="{Binding SalaryOrRate}" Width="105">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#047857"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Margin" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Source & Method -->
                        <DataGridTemplateColumn Header="Source / Method" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding Source}" FontWeight="Medium" Foreground="#334155" FontSize="12"/>
                                        <TextBlock Text="{Binding ApplicationMethod}" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Status" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                        <Border Background="{Binding StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}" 
                                                CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding CurrentStatus}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Staleness / Inactivity -->
                        <DataGridTemplateColumn Header="Last Activity" SortMemberPath="LastUpdatedDate" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding LastUpdatedFormatted}" FontSize="11" Foreground="#334155"/>
                                        <!-- Stale badge if stale -->
                                        <Border Background="#FFEDD5" CornerRadius="4" Padding="4,1" Margin="0,2,0,0" HorizontalAlignment="Left"
                                                Visibility="{Binding IsStale, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="{Binding StalenessText}" FontSize="10" FontWeight="Bold" Foreground="#C2410C"/>
                                        </Border>
                                        <!-- Normal relative time if not stale -->
                                        <TextBlock Text="{Binding StalenessText}" FontSize="10" Foreground="#94A3B8"
                                                   Visibility="{Binding IsStale, Converter={StaticResource BoolToVisConverter}, ConverterParameter='inverse'}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Files -->
                        <DataGridTemplateColumn Header="Files" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📎" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding AttachmentCount}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- RIGHT: Detail & Audit Trail Panel -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                <Grid>
                    <!-- Empty selection notice -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                                Visibility="{Binding HasSelectedApplication, Converter={StaticResource BoolToVisConverter}, ConverterParameter='invert'}">
                        <TextBlock Text="📋" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Select an application to view details" FontWeight="SemiBold" FontSize="15" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock Text="You can review the job spec, attached files, and full audit trail history." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Populated Details View -->
                    <Grid Visibility="{Binding HasSelectedApplication, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Action bar & title -->
                            <RowDefinition Height="*"/>    <!-- Tabs for Spec / Files / Audit -->
                        </Grid.RowDefinitions>

                        <!-- Top Title & Quick Actions -->
                        <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedApplication.DisplayTitle}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedApplication.DisplayCompanyAgency}" FontSize="13" Foreground="#475569" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="📄 Full Report" Padding="10,4" Margin="0,0,6,0" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="BtnPrintReport_Click" ToolTip="View &amp; Print Full Application Report with Spec, Events and Attachments list"/>
                                        <Button Content="✏️ Edit" Padding="8,4" Margin="0,0,6,0" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="BtnEditSelected_Click"/>
                                        <Button Content="🗑️" Padding="8,4" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" Click="BtnDeleteSelected_Click" ToolTip="Delete Application"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Action Button: Log Update -->
                                <Button Content="📝 Add Update / Change Status" Margin="0,10,0,0" Padding="12,7" Background="#2563EB" 
                                        Foreground="White" FontWeight="SemiBold" BorderThickness="0" HorizontalAlignment="Left" Click="BtnAddUpdate_Click"/>

                                <!-- Metadata Pills -->
                                <WrapPanel Margin="0,10,0,0">
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="{Binding SelectedApplication.CurrentStatus, StringFormat='Status: {0}'}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="{Binding SelectedApplication.Source, StringFormat='Source: {0}'}" FontSize="11"/>
                                    </Border>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="{Binding SelectedApplication.ApplicationMethod, StringFormat='Method: {0}'}" FontSize="11"/>
                                    </Border>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,6,4" 
                                            Visibility="{Binding SelectedApplication.SalaryOrRate, Converter={StaticResource NullToVisConverter}}">
                                        <TextBlock Text="{Binding SelectedApplication.SalaryOrRate, StringFormat='💰 {0}'}" FontSize="11"/>
                                    </Border>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,6,4" 
                                            Visibility="{Binding SelectedApplication.Location, Converter={StaticResource NullToVisConverter}}">
                                        <TextBlock Text="{Binding SelectedApplication.Location, StringFormat='📍 {0}'}" FontSize="11"/>
                                    </Border>
                                    <Button Content="🔗 Open URL" Padding="6,2" Margin="0,0,6,4" Background="#E0E7FF" Foreground="#3730A3" BorderThickness="0" 
                                            Command="{Binding OpenJobUrlCommand}" Visibility="{Binding SelectedApplication.JobUrl, Converter={StaticResource NullToVisConverter}}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tab Control for Spec, Files, Audit Trail -->
                        <TabControl Grid.Row="1" BorderBrush="#E2E8F0" Background="Transparent">
                            <!-- TAB 1: Job Spec Details -->
                            <TabItem Header="📋 Job Spec">
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="Job Specification / Details" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Content="📋 Copy Spec" HorizontalAlignment="Right" Padding="8,4" Background="#F1F5F9" 
                                                BorderBrush="#CBD5E1" Command="{Binding CopyJobSpecCommand}"/>
                                    </DockPanel>
                                    <TextBox Grid.Row="1" Text="{Binding SelectedApplication.JobSpecText, Mode=OneWay}" 
                                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                                             Background="#F8FAFC" BorderBrush="#E2E8F0" Padding="10" FontFamily="Segoe UI"/>
                                </Grid>
                            </TabItem>

                            <!-- TAB 2: File Attachments -->
                            <TabItem Header="📎 Attachments">
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="Attached Files (Specs, CV, Notes)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Content="+ Attach File..." HorizontalAlignment="Right" Padding="10,4" Background="#2563EB" 
                                                Foreground="White" FontWeight="SemiBold" BorderThickness="0" Command="{Binding AddAttachmentCommand}"/>
                                    </DockPanel>

                                    <ListBox Grid.Row="1" ItemsSource="{Binding Attachments}" BorderBrush="#E2E8F0" Background="#F8FAFC">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <DockPanel LastChildFill="True">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Open" Padding="8,3" Margin="0,0,6,0" Background="#FFFFFF" BorderBrush="#CBD5E1" 
                                                                    Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="📂" Padding="6,3" Margin="0,0,6,0" Background="#FFFFFF" BorderBrush="#CBD5E1" 
                                                                    Command="{Binding DataContext.OpenAttachmentFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                                    CommandParameter="{Binding}" ToolTip="Show in Explorer"/>
                                                            <Button Content="✕" Padding="6,3" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" 
                                                                    Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                                    CommandParameter="{Binding}" ToolTip="Delete File"/>
                                                        </StackPanel>

                                                        <StackPanel VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding FileIcon}" FontSize="14" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding FormattedSize, StringFormat='Size: {0}'}" FontSize="11" Foreground="#64748B" Margin="22,2,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </TabItem>

                            <!-- TAB 3: Audit Trail & Timeline -->
                            <TabItem Header="🕒 Audit Trail &amp; Updates">
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="Timeline History" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Content="+ Log Event" HorizontalAlignment="Right" Padding="10,4" Background="#2563EB" 
                                                Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="BtnAddUpdate_Click"/>
                                    </DockPanel>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding AuditUpdates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" 
                                                            Padding="12" Margin="0,0,0,8">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="📋 Copy Notes Text" Click="CopyAuditNote_Click"/>
                                                                <MenuItem Header="📋 Copy Full Entry" Click="CopyAuditEntry_Click"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding TypeIcon}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top"/>

                                                            <StackPanel Grid.Column="1">
                                                                <DockPanel>
                                                                    <Button Content="📋" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" 
                                                                            Cursor="Hand" ToolTip="Copy this audit entry" Margin="6,0,0,0"
                                                                            Click="BtnCopyAuditItem_Click" VerticalAlignment="Center" Padding="2"/>
                                                                    <TextBlock Text="{Binding UpdateDateFormatted}" FontSize="11" Foreground="#64748B" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                                                    <TextBox Text="{Binding SummaryTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="#0F172A" 
                                                                             IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                                                             Cursor="IBeam" FocusVisualStyle="{x:Null}" Padding="0" VerticalAlignment="Center"/>
                                                                </DockPanel>
                                                                <TextBox Text="{Binding Notes, Mode=OneWay}" TextWrapping="Wrap" Foreground="#334155" FontSize="12" 
                                                                         Margin="0,4,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                                                         Cursor="IBeam" FocusVisualStyle="{x:Null}" Padding="0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Status Bar -->
        <Border Grid.Row="4" Background="#E2E8F0" Padding="20,6">
            <DockPanel>
                <TextBlock Text="Ready" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Applications.Count, StringFormat='Showing {0} application(s)'}" 
                           FontSize="11" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
